# Copy to `.env` for local development. PLACEHOLDER values only — never commit real secrets.
# GitHub App OAuth + scopes are owned by IT and are not wired in this scaffold.

# --- GitHub App (STUB) ---
# TODO(IT): read-only GitHub App. Same install model as midkernel/app (install lives on Organization).
GITHUB_APP_MOCK="true"
GITHUB_APP_ID="PLACEHOLDER_GITHUB_APP_ID"
GITHUB_APP_PRIVATE_KEY="PLACEHOLDER_GITHUB_APP_PRIVATE_KEY"
GITHUB_APP_CLIENT_ID="PLACEHOLDER_GITHUB_APP_CLIENT_ID"
GITHUB_APP_CLIENT_SECRET="PLACEHOLDER_GITHUB_APP_CLIENT_SECRET"

# --- Scan execute (UNISSUED) ---
# Hosted start-run / status / report. Do not point this at a fake backend.
# TODO(Engineering): set when scan infra is issued. Until then start_run returns SCAN_INFRA_UNAVAILABLE.
SCAN_API_URL="PLACEHOLDER_SCAN_API_URL"
SCAN_API_TOKEN="PLACEHOLDER_SCAN_API_TOKEN"

# Public playbooks registry (read-only). Override only for tests.
PLAYBOOKS_REPO_URL="https://github.com/midkernel/playbooks"
PLAYBOOKS_CONTENTS_URL="https://api.github.com/repos/midkernel/playbooks/contents"

# Credits meter hosted runs. Do not implement Stripe in this package.

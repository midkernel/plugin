# Copy to `.env` for local development. PLACEHOLDER values only — never commit real secrets.

# --- Midkernel app Scan API (v0 one-shot; not AWS ECS agentflow) ---
# Production includes Next basePath `/app` (https://midkernel.com/app).
# Local: http://localhost:3000 or http://localhost:3000/app.
# Start:     POST {MIDKERNEL_APP_URL}/api/scans/start
# Status:    GET  {MIDKERNEL_APP_URL}/api/runs/:id
# Repos:     GET  {MIDKERNEL_APP_URL}/api/repos
# Playbooks: GET  {MIDKERNEL_APP_URL}/api/playbooks
MIDKERNEL_APP_URL="PLACEHOLDER_MIDKERNEL_APP_URL"
# Org-scoped PAT until Midkernel OAuth is live. Alias: SCAN_API_TOKEN.
MIDKERNEL_API_TOKEN="PLACEHOLDER_MIDKERNEL_API_TOKEN"

# --- Midkernel-as-AS (Cursor remote MCP; not Google) ---
# App will host (prefix MIDKERNEL_APP_URL):
#   GET  /.well-known/oauth-authorization-server
#   GET  /.well-known/oauth-protected-resource
#   GET  /oauth/authorize
#   POST /api/oauth/token
#   POST /api/oauth/register
#   MCP  /mcp
# Revoke is not hosted — do not call /oauth/revoke.
# Cursor redirects to register on the app AS:
#   https://www.cursor.com/agents/mcp/oauth/callback
#   http://localhost:8787/callback
# If those routes are not merged yet, the plugin returns AUTH_NOT_CONFIGURED.
MIDKERNEL_OAUTH_CLIENT_ID="PLACEHOLDER_MIDKERNEL_OAUTH_CLIENT_ID"
MIDKERNEL_OAUTH_CLIENT_SECRET="PLACEHOLDER_MIDKERNEL_OAUTH_CLIENT_SECRET"

# Optional: GitHub installation access token for read-only repo listing
# when /api/repos is not hosted yet.
GITHUB_INSTALLATION_TOKEN="PLACEHOLDER_GITHUB_INSTALLATION_TOKEN"

# --- GitHub App (credentials live on midkernel/app; placeholders here) ---
# TODO(IT): read-only GitHub App. Same install model as midkernel/app
# (install lives on Organization).
GITHUB_APP_ID="PLACEHOLDER_GITHUB_APP_ID"
GITHUB_APP_PRIVATE_KEY="PLACEHOLDER_GITHUB_APP_PRIVATE_KEY"
GITHUB_APP_CLIENT_ID="PLACEHOLDER_GITHUB_APP_CLIENT_ID"
GITHUB_APP_CLIENT_SECRET="PLACEHOLDER_GITHUB_APP_CLIENT_SECRET"

# Public playbooks registry (read-only). Override only for tests.
PLAYBOOKS_REPO_URL="https://github.com/midkernel/playbooks"
PLAYBOOKS_CONTENTS_URL="https://api.github.com/repos/midkernel/playbooks/contents"

# Credits meter hosted runs. Do not implement Stripe in this package.
